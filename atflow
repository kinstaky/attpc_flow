#!/bin/bash
# ATTPC Flow binary wrapper
# This script allows running atflow as ./atflow

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Run the Python module using uv from the project directory
cd "$SCRIPT_DIR"
nvm use v24;
uv sync --dev --all-extras;
exec uv run atflow "$@"
